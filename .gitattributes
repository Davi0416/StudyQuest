# Linguist — garante que Java seja a linguagem principal detectada
frontend/src/**/*.ts  linguist-detectable=false
frontend/src/**/*.tsx linguist-detectable=false
frontend/src/**/*.css linguist-detectable=false
frontend/**/*.js      linguist-vendored
electron/**/*.js      linguist-vendored
scripts/**/*.ps1      linguist-documentation
docs/**               linguist-documentation
mockups/              linguist-documentation
