{
  "name": "studyquest-desktop",
  "version": "1.1.2",
  "description": "StudyQuest – Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^26.0.0",
    "jimp": "^0.22.12",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.studyquest.app",
    "productName": "StudyQuest",
    "copyright": "Copyright © 2026 StudyQuest",
    "publish": {
      "provider": "github",
      "owner": "Davi0416",
      "repo": "StudyQuest"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "node_modules/**/*",
      "package.json",
      "icons/**/*"
    ],
    "extraResources": [
      {
        "from": "../api/target/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/python-win",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "mail.config.js",
        "to": "mail.config.js"
      }
    ],
    "win": {
      "icon": "icons/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "icons/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "icon": "icons/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "StudyQuest"
    }
  }
}
