# PostgreSQL remoto (Neon) — copie para .env e preencha
# Dashboard: https://console.neon.tech
# Connection string (pooler recomendado para apps):
POSTGRES_URL=jdbc:postgresql://ep-xxxx-pooler.region.aws.neon.tech/studyquest?sslmode=require
POSTGRES_USER=studyquest_owner
POSTGRES_PASSWORD=sua_senha_neon

# SQLite local (offline-first, perfil neon mantém cache local)
SQLITE_URL=jdbc:sqlite:studyquest-local-dev.db?journal_mode=WAL&busy_timeout=5000

# Groq / Judge0 / JWT — opcional em dev
GROQ_API_KEY=
JUDGE0_KEY=

# E-mail — Resend (recomendado): https://resend.com/api-keys
MAIL_PROVIDER=auto
MAIL_MOCK=false
MAIL_FROM=StudyQuest <onboarding@resend.dev>
RESEND_API_KEY=sua_chave_resend

# Alternativa Gmail SMTP:
# MAIL_PROVIDER=smtp
# MAIL_FROM=StudyQuest <seu@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu@gmail.com
# SMTP_PASSWORD=senha-de-app
# SMTP_STARTTLS=REQUIRED
